# Copy to web/.env and fill in. Never commit .env itself.

# --- FMD Main: the FastAPI backend (main-websie/server) ---
# Where /api/v1/* is forwarded (next.config.ts). Optional: defaults to http://localhost:8000.
# The site's own address must also be in the backend's ALLOWED_ORIGINS.
FMD_API_URL=http://localhost:8000

# --- Homepage waitlist (src/lib/db.ts, src/app/api/waitlist) ---
# PostgreSQL connection string. Required for the waitlist form.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Email: waitlist and FMD Edge enquiry notifications ---
# Required for those emails. SMTP_USER is also the from and to address. Port defaults to 465 (SSL).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=hello@example.com
SMTP_PASS=

# --- Clinic app's local server (src/server): all optional ---
# SQLite file. Default: web/.data/fmd.db (on Vercel: /tmp/fmd.db, wiped on restart).
# FMD_DB=.data/fmd.db
# Set to 0 to skip seeding the demo directory in development.
# FMD_SEED_DEMO=1
# Staff roles, given by email at sign-up (comma-separated).
# FMD_ADMIN_EMAILS=
# FMD_OPS_EMAILS=
# FMD_ACCOUNTANT_EMAILS=

# --- 3D models upload (scripts/upload-models.mjs only; needs USE_CLOUDINARY_MODELS in src/toggle.ts) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend-only demo: no backend, three fixed accounts (src/lib/fmdDemo.ts).
# NEXT_PUBLIC_FMD_DEMO=1
